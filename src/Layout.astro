---
interface Props { title: string; }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en" class="bg-white text-zinc-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">
  </head>
  <body class="font-['Inter'] antialiased">
    <nav class="flex justify-between items-center px-8 py-10 max-w-7xl mx-auto border-b border-zinc-100">
      <a href="/" class="text-2xl font-['Playfair_Display'] tracking-tight">Studio Name</a>
      <div class="space-x-8 text-sm uppercase tracking-widest font-light">
        <a href="/for-sale" class="hover:text-zinc-500 transition">For Sale</a>
        <a href="/portfolio" class="hover:text-zinc-500 transition">Work</a>
        <a href="#contact" class="hover:text-zinc-500 transition">Contact</a>
      </div>
    </nav>
    <slot />
  </body>
</html>
