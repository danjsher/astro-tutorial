---
import FurnitureEntry from '@components/FurnitureEntry.astro'

import before1Image from "/src/assets/images/before1.png";
import after1Image from "/src/assets/images/after1.png";
import before2Image from "/src/assets/images/before2.png";
import after2Image from "/src/assets/images/after2.png";

const myProjects = [
  {
    title: "Live Edge Walnut Table",
    price: 0,
    dimensions: "something x something inches",
    description: "A statement piece featuring locally sourced walnut and industrial steel legs.",
    images: [before2Image, after1Image],
  },
  {
    title: "Minimalist Oak Desk",
    price: 0,
    dimensions: "something x something inches",
    description: "Designed for small spaces with integrated cable management.",
    images: [before2Image, after1Image],
  }
];

---

<section id="portfolio" class="portfolio">
  <div class="section-container">
    <span class="section-tag">Furniture</span>
    <h2 class="section-title">Some things I have built</h2>
    {
      myProjects.map((project) => (
        <FurnitureEntry {...project} /> 
      ))
    }
  </div>
</section>

