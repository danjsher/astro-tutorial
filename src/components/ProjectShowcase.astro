---
import { Image } from "astro:assets";
/**
 * ProjectShowcase.astro
 * A reusable component with a Swiper gallery on the left and text on the right.
 */
interface Props {
  id: string; // Unique ID required for multiple Swiper instances
  title: string;
  subtitle?: string;
  description: string;
  images: string[]; // Array of image URLs
  details?: { label: string; value: string }[];
}

const { id, title, subtitle, description, images, details = [] } = Astro.props;
---

<section class="project-showcase-item my-5">
  <div class="container">
    <div class="row align-items-center g-0 showcase-wrapper">
      
      <div class="col-lg-7">
        <div class={`swiper-container swiper-${id} showcase-slider`}>
          <div class="swiper-wrapper">
            {images.map((src) => (
              <div class="swiper-slide">
                  <Image
                      class="showcase-img"
                      src={src}
                      alt=""
                  />
              </div>
            ))}
          </div>
          <div class={`swiper-pagination pagination-${id}`}></div>
        </div>
      </div>

      <div class="col-lg-5">
        <div class="showcase-content p-4 p-md-5">
          {subtitle && <span class="showcase-subtitle">{subtitle}</span>}
          <h2 class="showcase-title">{title}</h2>
          <p class="showcase-description">{description}</p>
          
          {details.length > 0 && (
            <ul class="showcase-details list-unstyled mt-4">
              {details.map((item) => (
                <li>
                  <strong>{item.label}:</strong> {item.value}
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .showcase-wrapper {
    border: 1px solid #eee;
    background: #fff;
    overflow: hidden;
  }
  
  .showcase-slider {
    width: 100%;
    height: 500px;
  }

  .showcase-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .showcase-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .showcase-subtitle {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #999;
    margin-bottom: 10px;
    display: block;
  }

  .showcase-title {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    font-weight: 600;
  }

  .showcase-description {
    line-height: 1.7;
    color: #555;
  }

  .showcase-details li {
    margin-bottom: 8px;
    font-size: 0.95rem;
  }
</style>

<script is:inline define:vars={{ id }}>
  // Using define:vars to pass the unique ID into the client-side script
  new Swiper(`.swiper-${id}`, {
    loop: true,
    speed: 800,
    effect: 'fade',
    fadeEffect: { crossFade: true },
    pagination: {
      el: `.pagination-${id}`,
      clickable: true,
    },
    autoplay: {
      delay: 4000,
      disableOnInteraction: false,
    },
  });
</script>
